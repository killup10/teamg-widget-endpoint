{
  "name": "teamg-widget-endpoint",
  "version": "1.0.0",
  "description": "JSON endpoint for TeamG Play NetCast widget via Media Station X",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "npm install --omit=dev && node scripts/ensure-yt-dlp.js || true",
    "deploy": "vercel --prod",
    "postinstall": "node scripts/ensure-yt-dlp.js || true"
  },
  "dependencies": {
    "d-fi-core": "^1.4.0",
    "egoroof-blowfish": "^4.0.3",
    "ffmpeg-static": "5.3.0",
    "mongodb": "^6.9.0",
    "sharp": "0.34.5"
  },
  "keywords": [
    "teamg",
    "netcast",
    "lg-tv",
    "media-station-x",
    "http-server",
    "railway"
  ],
  "author": "TeamG",
  "license": "MIT",
  "engines": {
    "node": ">=18.17.0"
  }
}
